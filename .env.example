# ---- LLM: choose one provider (groq | openai | azure) ----
LLM_PROVIDER=groq
# Groq free tier model. For OpenAI use e.g. gpt-4o-mini
LLM_MODEL=openai/gpt-oss-120b
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
# e.g. https://<resource>.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# ---- Database (defaults match docker-compose) ----
DATABASE_URL=postgresql://analyst_admin:admin@localhost:5433/analyst
READONLY_DATABASE_URL=postgresql://analyst_ro:readonly@localhost:5433/analyst

# ---- Optional tracing: Langfuse (free cloud tier or self-hosted) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
